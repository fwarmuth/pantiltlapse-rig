{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Backend Server (Simulation / Fake Camera)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/backend/main.py",
            "cwd": "${workspaceFolder}/backend",
            "env": {
                "FAKE_CAMERA": "true",
                "SERIAL_PORT": "/dev/ttyUSB0",
                "SERIAL_BAUD": "9600",
                "PYTHONPATH": "${workspaceFolder}/backend"
            },
            "console": "integratedTerminal",
            "justMyCode": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "Uvicorn running on http://(?:[0-9.]+|localhost):([0-9]+)",
                "uriFormat": "http://localhost:%s"
            }
        },
        {
            "name": "Backend Server (Live Hardware)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/backend/main.py",
            "cwd": "${workspaceFolder}/backend",
            "env": {
                "FAKE_CAMERA": "false",
                "SERIAL_PORT": "/dev/ttyUSB0",
                "SERIAL_BAUD": "9600",
                "PYTHONPATH": "${workspaceFolder}/backend"
            },
            "console": "integratedTerminal",
            "justMyCode": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "Uvicorn running on http://(?:[0-9.]+|localhost):([0-9]+)",
                "uriFormat": "http://localhost:%s"
            }
        },
        {
            "name": "Motor Serial CLI",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/backend/cli.py",
            "cwd": "${workspaceFolder}/backend",
            "env": {
                "SERIAL_PORT": "/dev/ttyUSB0",
                "SERIAL_BAUD": "9600",
                "PYTHONPATH": "${workspaceFolder}/backend"
            },
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}
