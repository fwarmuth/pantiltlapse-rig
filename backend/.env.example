# CameraCommander3 Deployment Environment Settings

# Serial communication port for ESP32 stepper motor controller
# Examples: /dev/ttyUSB0, /dev/ttyACM0, /dev/serial/by-id/...
SERIAL_PORT=/dev/ttyUSB0

# Serial baud rate (must match ESP32 firmware configuration)
SERIAL_BAUD=9600

# Enable synthetic camera simulation (true / false)
# Set to 'true' when testing without physical gPhoto2 camera attached
FAKE_CAMERA=false
